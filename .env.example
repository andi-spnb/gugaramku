# Environment Variables
# Salin file ini ke .env.local dan isi dengan nilai yang sesuai

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL="postgresql://username:password@localhost:5432/gugaramku?schema=public"

# ===========================================
# AUTHENTICATION
# ===========================================
# Generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# ===========================================
# APPLICATION
# ===========================================
NEXT_PUBLIC_APP_NAME="GuGaramKu"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===========================================
# FILE UPLOAD
# ===========================================
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE="5242880"

# ===========================================
# SOCKET.IO (untuk real-time sync)
# ===========================================
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"

# ===========================================
# EMAIL (untuk reset password)
# ===========================================
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@gugaramku.com"
